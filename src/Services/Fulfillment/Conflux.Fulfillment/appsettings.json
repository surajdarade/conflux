{
  "ConnectionStrings": {
    "FulfillmentDatabase": "Host=localhost;Port=5432;Database=conflux_fulfillment;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "OrderEventsTopic": "conflux.order.events",
    "ConsumerGroup": "conflux-fulfillment-v1",
    "FailureDelay": "00:00:02"
  },
  "AllowedHosts": "*",
  "KafkaRetry": {
    "BootstrapServers": "localhost:9092",
    "SourceTopics": [
      "conflux.order.events"
    ],
    "ConsumerGroup": "conflux-fulfillment-retry-v1",
    "MaxAttempts": 3,
    "BaseDelay": "00:00:02",
    "PollInterval": "00:00:00.250",
    "AutomaticDlqRecovery": true,
    "DlqRecoveryDelay": "00:05:00"
  }
}
