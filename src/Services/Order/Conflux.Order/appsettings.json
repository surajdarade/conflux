{
  "ConnectionStrings": {
    "OrderDatabase": "Host=localhost;Port=5432;Database=conflux_order;Username=postgres;Password=postgres"
  },
  "Services": {
    "Inventory": {
      "GrpcAddress": "http://localhost:5027"
    },
    "Payment": {
      "BaseAddress": "http://localhost:5150"
    }
  },
  "AllowedHosts": "*",
  "CheckoutSaga": {
    "BootstrapServers": "localhost:9092",
    "OrderEventsTopic": "conflux.order.events",
    "PaymentEventsTopic": "conflux.payment.events",
    "ConsumerGroup": "conflux-order-checkout-saga-v1",
    "FailureDelay": "00:00:02",
    "Enabled": true
  },
  "KafkaRetry": {
    "BootstrapServers": "localhost:9092",
    "SourceTopics": [
      "conflux.order.events",
      "conflux.payment.events"
    ],
    "ConsumerGroup": "conflux-order-checkout-retry-v1",
    "MaxAttempts": 3,
    "BaseDelay": "00:00:02",
    "PollInterval": "00:00:00.250",
    "AutomaticDlqRecovery": true,
    "DlqRecoveryDelay": "00:05:00"
  }
}
