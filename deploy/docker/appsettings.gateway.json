{
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/v1/inventory/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        }
      },
      "fulfillment-route": {
        "ClusterId": "fulfillment",
        "Match": {
          "Path": "/api/v1/fulfillment/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "service": {
            "Address": "http://identity:8080"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "service": {
            "Address": "http://catalog:8080"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "service": {
            "Address": "http://inventory:8080"
          }
        }
      },
      "order": {
        "Destinations": {
          "service": {
            "Address": "http://order:8080"
          }
        }
      },
      "payment": {
        "Destinations": {
          "service": {
            "Address": "http://payment:8080"
          }
        }
      },
      "fulfillment": {
        "Destinations": {
          "service": {
            "Address": "http://fulfillment:8080"
          }
        }
      }
    }
  }
}
